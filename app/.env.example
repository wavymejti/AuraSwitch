# Devnet RPC (default: public devnet endpoint)
VITE_RPC=https://api.devnet.solana.com
# Heartbeat device key – DEVNET ONLY. JSON array from `solana-keygen new` (careswitch/keys/heartbeat.json)
VITE_HEARTBEAT_SECRET=
# Demo payees (pre-fill the allowlist form)
VITE_APTEKA=
VITE_OSRODEK=
# Payer of durable-nonce accounts (program/scripts/create-nonces.ts) – makes wallet txs never expire
VITE_NONCE_BASE=
